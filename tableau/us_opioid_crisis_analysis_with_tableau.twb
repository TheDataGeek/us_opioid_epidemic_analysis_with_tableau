            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4046' />
            <zone h='84647' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14523'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Fentanyl and prescription opioids dominate overdose deaths' captured-sheet='Dashboard 1' id='2' />
                  <story-point caption='Adjusting for population reveals the hardest hit states' captured-sheet='Dashboard 2' id='3' />
                  <story-point caption='A nationwide epidemic, unevenly distributed&quot;' captured-sheet='Dashboard 3' id='4' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
