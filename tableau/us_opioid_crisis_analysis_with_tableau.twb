    <worksheet name='Deaths by Drug Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='14'>Opioid Deaths by Drug Category</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontname='Benton Sans Book'>Includes opioid-related overdose deaths with an underlying cause classified as drug-induced (unintentional, suicide, homicide, or undetermined intent) per the International Classification of Diseases, Tenth Revision (ICD-10).</run>
            <run>Æ&#10;&#10;</run>
            <run fontname='Benton Sans Book'>Opioid categories are identified via the ICD-10 Multiple Cause of Death field and include: Heroin (T40.1), Other Opioids (T40.2 — prescription opioids including oxycodone and hydrocodone), Methadone (T40.3), Other Synthetic Opioids (T40.4 — including fentanyl and tramadol), and Other &amp; Unspecified Opioids (T40.6). Opium (T40.0) and Cocaine (T40.5) are excluded from this analysis.</run>
            <run>Æ&#10;&#10;</run>
            <run fontname='Benton Sans Book'>Death counts representing fewer than ten (1-9) persons have been suppressed in accordance with National Center for Health Statistics (NCHS) confidentiality standards. Suppressed values are excluded from aggregate totals. Rates based on fewer than 20 deaths are flagged as unreliable.</run>
            <run>Æ&#10;</run>
            <run fontname='Benton Sans Book'>Source: Multiple Cause of Death 1999–2020, CDC WONDER Online Database, released 2021. Available at: </run>
            <run auto-url='true' fontname='Benton Sans Book' hyperlink='tabdoc:load-url url=&amp;quot;https://wonder.cdc.gov/mcd-icd10.html&amp;quot;' underline='true'>https://wonder.cdc.gov/mcd-icd10.html</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='YEAR_STATE_AGE_MCD_1999_2020_cleaned' name='federated.0gtylqh01nfq941b69hlg115gqqf' />
          </datasources>
          <datasource-dependencies datasource='federated.0gtylqh01nfq941b69hlg115gqqf'>
            <column datatype='real' name='[Deaths]' role='measure' type='quantitative' />
            <column datatype='string' name='[Multiple Cause of Death]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Heroin&quot;' value='Heroin (Semi-Synthetic)' />
                <alias key='&quot;Methadone&quot;' value='Methadone (Synthetic)' />
                <alias key='&quot;Other and unspecified narcotics&quot;' value='Other + Unspecified' />
                <alias key='&quot;Other opioids&quot;' value='Prescription' />
                <alias key='&quot;Other synthetic narcotics&quot;' value='Fentanyl + Synthetic' />
              </aliases>
            </column>
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Multiple Cause of Death]' derivation='None' name='[none:Multiple Cause of Death:nk]' pivot='key' type='nominal' />
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Deaths]' derivation='Sum' name='[sum:Deaths:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0gtylqh01nfq941b69hlg115gqqf].[none:Multiple Cause of Death:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Multiple Cause of Death:nk]' />
              <groupfilter function='member' level='[none:Multiple Cause of Death:nk]' member='&quot;Opium&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0gtylqh01nfq941b69hlg115gqqf].[none:Multiple Cause of Death:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Methadone&quot;</bucket>
              <bucket>&quot;Other and unspecified narcotics&quot;</bucket>
