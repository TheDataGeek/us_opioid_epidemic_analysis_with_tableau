    <worksheet name='U.S. State Populations'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='14'>U.S. State Populations</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontname='Benton Sans Book'>Population estimates are U.S. Census Bureau bridged-race estimates of U.S. state resident populations, as reported in the Multiple Cause of Death 1999-2020, CDC WONDER Online Database, released 2021. Available at: </run>
            <run auto-url='true' fontname='Benton Sans Book' hyperlink='tabdoc:load-url url=&amp;quot;https://wonder.cdc.gov/mcd-icd10.html&amp;quot;' underline='true'>https://wonder.cdc.gov/mcd-icd10.html</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='YEAR_STATE_1999_2020_cleaned' name='federated.1yk5wab190sru01firanw1r3yjb0' />
          </datasources>
          <datasource-dependencies datasource='federated.1yk5wab190sru01firanw1r3yjb0'>
            <column caption='Highest Crude Rate vs Most Deaths' datatype='string' name='[Calculation_1081309224189955]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [State] IN (&quot;Ohio&quot;, &quot;Maryland&quot;, &quot;Massachusetts&quot;, &quot;West Virginia&quot;) &#10;THEN &quot;Highest Crude Rate&quot; &#10;ELSEIF [State] IN (&quot;California&quot;, &quot;Texas&quot;, &quot;Florida&quot;, &quot;New York&quot;) &#10;THEN &quot;Most Deaths&quot; &#10;ELSE &quot;Other&quot; &#10;END' />
            </column>
            <column datatype='integer' name='[Population]' role='measure' type='quantitative' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Population]' derivation='Avg' name='[avg:Population:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1081309224189955]' derivation='None' name='[none:Calculation_1081309224189955:nk]' pivot='key' type='nominal' />
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
            <column-instance column='[Population]' derivation='Sum' name='[sum:Population:qk]' pivot='key' type='quantitative' />
